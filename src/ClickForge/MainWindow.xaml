<Window x:Class="ClickForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClickForge" Icon="{StaticResource ForgeIcon}" Width="1000" Height="880" MinWidth="640" MinHeight="600" Background="{StaticResource Base}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" KeyboardNavigation.TabNavigation="Continue" SizeChanged="LayoutChanged">
 <Grid x:Name="Shell" Margin="24,18,24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="BrandWordmark" Text="ClickForge" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ActiveProfileText" Text="Custom configuration" Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0" AutomationProperties.Name="Active configuration profile"/></StackPanel>
   <StackPanel x:Name="RailFooter" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="RailState" Text="Stopped" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VersionLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10">
   <Button x:Name="NavDashboard" Content="Home" Click="DashboardClicked" Margin="0,0,7,5" Padding="12,7"/>
   <Button x:Name="NavProfiles" Content="Profiles" Click="ProfilesClicked" Margin="0,0,7,5" Padding="12,7"/>
   <Button x:Name="NavTarget" Content="Choose window" Click="TargetClicked" Margin="0,0,7,5" Padding="12,7"/>
   <Button x:Name="NavHotkeys" Content="Shortcuts" Click="HotkeysClicked" Margin="0,0,7,5" Padding="12,7"/>
   <Button x:Name="NavSettings" Content="Settings" Click="SettingsClicked" Margin="0,0,7,5" Padding="12,7"/>
   <Button x:Name="NavUpdates" Content="Updates" Click="UpdatesClicked" Margin="0,0,0,5" Padding="12,7"/>
  </WrapPanel>
  <ScrollViewer x:Name="DashboardScroll" Grid.Row="2" SizeChanged="DashboardSizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,8">
    <Grid x:Name="StatusGrid" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" Text="Stopped" FontSize="22" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StateHintText" Visibility="Collapsed"/><Border x:Name="StateRing" Visibility="Collapsed"><TextBlock x:Name="StateGlyph"/></Border></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,7,0,0"><TextBlock x:Name="RobloxStatusText" Style="{StaticResource Hint}" FontSize="12"/><TextBlock x:Name="TargetText" Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    </Grid>
    <Border Style="{StaticResource PanelStyle}" Padding="18,12" Margin="0,0,0,12"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><Label Content="Setup" Target="{Binding ElementName=SetupInput}" Padding="0" Margin="0,0,0,6" FontWeight="SemiBold"/>
       <ComboBox x:Name="SetupInput" Width="245" HorizontalAlignment="Left" SelectionChanged="SetupChanged" AutomationProperties.Name="Clicking setup"><ComboBoxItem Content="Regular clicker"/><ComboBoxItem Content="Mouse buttons"/><ComboBoxItem Content="Minecraft Bedwars"/></ComboBox>
      </StackPanel>
      <Button x:Name="MouseControlsButton" Grid.Column="1" Content="Small view" Click="OpenMouseControlsClicked" VerticalAlignment="Bottom" Padding="12,9" AutomationProperties.Name="Open simple mouse controls"/>
     </Grid>
     <TextBlock x:Name="SetupDescription" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
     <TextBlock x:Name="SetupAssignments" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
     <WrapPanel x:Name="AssignmentActions" Margin="0,10,0,0" Visibility="Collapsed"><Button x:Name="BackToggleButton" Content="Back" Click="BackToggleClicked" Margin="0,0,8,4" Padding="12,8" AutomationProperties.Name="Toggle back side-button output"/><Button x:Name="FrontToggleButton" Content="Front" Click="FrontToggleClicked" Margin="0,0,8,4" Padding="12,8" AutomationProperties.Name="Toggle front side-button output"/><Button x:Name="SetupTargetButton" Content="Choose window" Click="TargetClicked" Padding="12,8" Margin="0,0,0,4" Visibility="Collapsed"/></WrapPanel>

    </StackPanel></Border>
    <Border Style="{StaticResource PanelStyle}" Padding="18,12" Margin="0,0,0,12"><StackPanel>
     <WrapPanel Margin="0,0,0,12"><TextBlock Text="Speed" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,5"/><RadioButton x:Name="FixedTimingInput" Content="Fixed CPS" GroupName="Timing" Style="{StaticResource TimingSegment}" Checked="TimingModeChanged" Margin="0,0,5,5" Padding="14,8"/><RadioButton x:Name="VariableTimingInput" Content="Variable CPS" GroupName="Timing" Style="{StaticResource TimingSegment}" Checked="TimingModeChanged" Margin="0,0,0,5" Padding="14,8"/></WrapPanel>
     <WrapPanel x:Name="OutputChoicePanel" Margin="0,0,0,10"><Label Content="Output" Target="{Binding ElementName=InputTypeInput}" Padding="0" VerticalAlignment="Center" Margin="0,0,10,4"/><ComboBox x:Name="InputTypeInput" Width="112" Margin="0,0,8,4" SelectionChanged="InputTypeChanged" AutomationProperties.Name="Output input type, separate from global hotkeys" ToolTip="Choose mouse clicks or one keyboard key."/><ComboBox x:Name="ClickButtonInput" Width="160" Margin="0,0,0,4" SelectionChanged="ClickButtonChanged" AutomationProperties.Name="Mouse output button"/><Button x:Name="ChangeCustomKeyButton" Content="Choose key" Click="ChangeCustomKeyClicked" Visibility="Collapsed" Margin="0,0,0,4" Padding="12,8"/></WrapPanel>
     <TextBlock x:Name="OutputRateHelp" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
     <StackPanel x:Name="FixedSpeedPanel">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="CpsInput" Text="10" Width="82" FontSize="27" FontWeight="SemiBold" Padding="8,3" HorizontalContentAlignment="Center" Foreground="{StaticResource Accent}" AutomationProperties.Name="Clicks per second, 1 to 50" TextChanged="CpsTyped" PreviewKeyDown="CpsKeyDown" LostFocus="CpsLostFocus"/><TextBlock Grid.Column="1" Text="CPS" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock x:Name="IntervalText" Grid.Column="2" Text="100 ms interval" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
      <Slider x:Name="CpsSlider" Minimum="1" Maximum="50" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged" Margin="0,5,0,3" AutomationProperties.Name="Click speed"/><Grid><TextBlock Text="1 CPS" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="50 CPS" Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Right"/></Grid>
     </StackPanel>
     <StackPanel x:Name="VariableSpeedPanel" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><Label Content="Minimum CPS" Target="{Binding ElementName=MinimumCpsInput}" Padding="0"/><TextBox x:Name="MinimumCpsInput" Width="85" HorizontalAlignment="Left" FontSize="24" Padding="8,3" Margin="0,6,0,0" TextChanged="VariableTyped" AutomationProperties.Name="Minimum CPS, 1 to 50"/><Slider x:Name="MinimumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" Margin="0,8,0,0" AutomationProperties.Name="Minimum CPS"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0"><Label Content="Maximum CPS" Target="{Binding ElementName=MaximumCpsInput}" Padding="0"/><TextBox x:Name="MaximumCpsInput" Width="85" HorizontalAlignment="Left" FontSize="24" Padding="8,3" Margin="0,6,0,0" TextChanged="VariableTyped" AutomationProperties.Name="Maximum CPS, 1 to 50"/><Slider x:Name="MaximumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" Margin="0,8,0,0" AutomationProperties.Name="Maximum CPS"/></StackPanel>
     </Grid><TextBlock x:Name="VariableRangeText" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="VariableValidationText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/></StackPanel>
    </StackPanel></Border>
    <WrapPanel Margin="0,0,0,10"><Button Content="Try safe test" Click="TestClicked" Padding="12,8" Margin="0,0,12,4"/><TextBlock Text="Test away from your game." Style="{StaticResource Hint}" VerticalAlignment="Center"/></WrapPanel>
    <Expander x:Name="SessionDetails" Header="Session stats" Margin="0,0,0,10"><WrapPanel Margin="0,10,0,0">
     <StackPanel Width="170" Margin="0,0,10,10"><TextBlock x:Name="SessionElapsedText" Text="00:00:00" FontSize="19" AutomationProperties.Name="Session wall-clock elapsed time"/><TextBlock Text="Elapsed, including pauses" Style="{StaticResource Hint}" FontSize="11"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,10,10"><TextBlock x:Name="SessionPairsText" Text="0" FontSize="19" AutomationProperties.Name="Input pairs sent during this session"/><TextBlock Text="Session input pairs sent" Style="{StaticResource Hint}" FontSize="11"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,10,10"><TextBlock x:Name="SessionAverageText" Text="0.00" FontSize="19" AutomationProperties.Name="Measured average CPS over session wall-clock time"/><TextBlock Text="Measured average CPS" Style="{StaticResource Hint}" FontSize="11"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,10,10"><TextBlock x:Name="CycleText" Text="0" FontSize="19"/><TextBlock Text="Total input pairs this run" Style="{StaticResource Hint}" FontSize="11"/></StackPanel>
     <StackPanel Width="170" Margin="0,0,10,10"><TextBlock x:Name="ConfiguredCpsText" Text="10" FontSize="19"/><TextBlock Text="Configured CPS" Style="{StaticResource Hint}" FontSize="11"/><TextBlock x:Name="ConfiguredIntervalText" Style="{StaticResource Hint}" FontSize="11"/></StackPanel>
    </WrapPanel></Expander>
    <Expander x:Name="ShortcutsExpander" Header="More settings" Margin="0,0,0,8" AutomationProperties.Name="Configure global shortcuts"><StackPanel Margin="0,12,0,0">
     <Grid x:Name="OptionsGrid" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ModePanel" Style="{StaticResource PanelStyle}" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="Activation" FontWeight="SemiBold"/><Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="ToggleModeInput" Content="Toggle" GroupName="Activation" Style="{StaticResource Segment}" Checked="ModeSegmentChanged" Margin="0,0,3,0" AutomationProperties.Name="Toggle activation mode"/><RadioButton x:Name="HoldModeInput" Grid.Column="1" Content="Hold" GroupName="Activation" Style="{StaticResource Segment}" Checked="ModeSegmentChanged" Margin="3,0,0,0" AutomationProperties.Name="Hold activation mode"/></Grid><TextBlock x:Name="ModeHelp" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border x:Name="RestrictionPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="14" Margin="6,0,0,0"><StackPanel><CheckBox x:Name="RestrictInput" Content="Only click while Roblox is in front" Checked="RestrictionChanged" Unchecked="RestrictionChanged"/><TextBlock x:Name="RestrictionHelp" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
     </Grid>
     <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,0,0,8"/><UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Start / stop" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="ActivateInput" AutomationProperties.Name="Activation hotkey"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Pause / resume" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="PauseInput" AutomationProperties.Name="Pause hotkey"/></StackPanel><StackPanel><TextBlock Text="Emergency stop" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="StopInput" AutomationProperties.Name="Emergency stop hotkey"/></StackPanel></UniformGrid>
     <WrapPanel Margin="0,10,0,12"><Button Content="Apply shortcuts" Click="ApplyClicked" Margin="0,0,8,0"/><Button Content="Reset shortcuts" Click="ResetClicked"/></WrapPanel>
     <CheckBox x:Name="SideButtonTogglesInput" Content="Enable side-button toggles" Checked="SideButtonTogglesChanged" Unchecked="SideButtonTogglesChanged" AutomationProperties.Name="Enable Mouse 4 and Mouse 5 output toggles" Margin="0,0,0,14"/>
     <TextBlock Text="Safe test options" FontWeight="SemiBold"/><TextBlock x:Name="SafeTestBadge" Style="{StaticResource Hint}" Margin="0,5,0,5"/><ComboBox x:Name="SafeTestModeInput" SelectedIndex="0" SelectionChanged="SafeModeDescriptionChanged" MaxWidth="320" HorizontalAlignment="Left" AutomationProperties.Name="Safe click test timing mode"><ComboBoxItem Content="Fixed CPS · controlled target"/><ComboBoxItem Content="Variable Timing — Safe Test Only"/></ComboBox><TextBlock x:Name="SafeTestDescription" Style="{StaticResource Hint}" Margin="0,7,0,14"/>
    </StackPanel></Expander>
    <TextBlock x:Name="MessageText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="StartClicked" Margin="0,0,8,0" Padding="12,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="StartIcon" Visibility="Collapsed"/><TextBlock x:Name="StartLabel" Text="Start" Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="StartKeyText" Text="F6" Foreground="{StaticResource Ink}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="PauseButton" Grid.Column="1" Click="PauseClicked" Margin="0,0,8,0" Padding="12,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="PauseLabel" Text="Pause"/><TextBlock x:Name="PauseKeyText" Text="F7" Margin="12,0,0,0" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Button>
   <Button x:Name="EmergencyButton" Grid.Column="2" Style="{StaticResource EmergencyButton}" Click="EmergencyClicked" Padding="12,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="EmergencyText" Text="Emergency stop" Foreground="{StaticResource Failure}"/><TextBlock x:Name="StopKeyText" Text="F8" Foreground="{StaticResource Failure}" Margin="12,0,0,0" FontSize="12"/></StackPanel></Button>
  </Grid></Border>
<ScrollViewer x:Name="InspectorHost" Grid.Row="2" Visibility="Collapsed" Margin="0,40,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorContent">
 <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0,0,0,10"><StackPanel>
 <DockPanel Margin="0,0,0,16"><Path Data="{StaticResource IconTarget}" Style="{StaticResource LineIcon}" Stroke="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Selected target" FontSize="15" FontWeight="SemiBold"/></DockPanel>
 <Border Background="{StaticResource Base}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,14"><StackPanel><Path Data="{StaticResource IconWindow}" Style="{StaticResource LineIcon}" Width="36" Height="36" Stroke="{StaticResource Muted}" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock x:Name="InspectorIdentity" Text="No window selected" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="InspectorVerification" Text="Choose a target for Variable CPS" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
 <TextBlock x:Name="InspectorEligibilityText" Text="Select an eligible target window." Style="{StaticResource Hint}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/><DockPanel Margin="0,0,0,10"><TextBlock Text="Process state" Style="{StaticResource Hint}" Margin="0,0,12,0"/><TextBlock x:Name="InspectorProcessState" Text="Not selected" FontSize="12"/></DockPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <TextBlock Text="Process" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorProcess" Grid.Column="1" Text="—" TextWrapping="Wrap" FontSize="12"/>
 <TextBlock Grid.Row="1" Text="Title" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorTitle" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" FontSize="12"/>
 <TextBlock Grid.Row="2" Text="Focus" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorFocus" Grid.Row="2" Grid.Column="1" Text="No target" FontSize="12"/>
 <TextBlock Grid.Row="3" Text="Window" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorValidity" Grid.Row="3" Grid.Column="1" Text="Not selected" FontSize="12"/>
 <TextBlock Grid.Row="4" Text="Pointer" Style="{StaticResource Hint}"/><TextBlock x:Name="InspectorPointer" Grid.Row="4" Grid.Column="1" Text="Not measured" FontSize="12" TextWrapping="Wrap"/></Grid>
      <StackPanel><Button Content="Refresh windows"  Click="RefreshTargetsClicked" Padding="10,6" Margin="0,0,0,8"/><Grid><ComboBox x:Name="DesktopTargetInput" MinWidth="100" SelectionChanged="DesktopTargetChanged" AutomationProperties.Name="Required target window, including verified Roblox" ToolTip="Select Roblox or another desktop window. Roblox clients must pass signature verification."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" MaxWidth="205" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="TargetPlaceholder" Text="Select a window…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="12,7,30,7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></StackPanel>
 <TextBlock x:Name="InspectorFeedback" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/><TextBlock x:Name="InspectorPolicyText" Text="Fixed CPS follows its saved foreground restriction. The selected window applies to Variable CPS." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
 </StackPanel></Border>
 <Border Style="{StaticResource PanelStyle}" Padding="18"><StackPanel><DockPanel Margin="0,0,0,14"><Path Data="{StaticResource IconLayers}" Style="{StaticResource LineIcon}" Stroke="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Profile" FontWeight="SemiBold" FontSize="15"/></DockPanel>
 <Grid><ComboBox x:Name="QuickProfileInput" AutomationProperties.Name="Apply a saved timing profile" SelectionChanged="QuickProfileChanged" ToolTip="Selecting a saved profile applies it and stops clicking."/><TextBlock x:Name="ProfilePlaceholder" Text="Custom configuration" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="12,7,30,7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid><TextBlock x:Name="QuickProfileSummary" Style="{StaticResource Hint}" Text="Custom configuration" Margin="0,9,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Save" Click="QuickProfileSaveClicked" Margin="0,0,5,0" Padding="8,9"/><Button Grid.Column="1" Content="Manage" Click="ProfilesClicked" Margin="5,0,0,0" Padding="8,9"/></Grid></StackPanel></Border>
 </StackPanel></ScrollViewer>
 </Grid>
</Window>
