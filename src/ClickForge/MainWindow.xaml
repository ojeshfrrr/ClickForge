<Window x:Class="ClickForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClickForge" Icon="{StaticResource ForgeIcon}" Width="1280" Height="920" MinWidth="620" MinHeight="600" Background="{StaticResource Base}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" KeyboardNavigation.TabNavigation="Continue" SizeChanged="LayoutChanged">
 <Grid x:Name="Shell" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="170"/><ColumnDefinition/><ColumnDefinition x:Name="InspectorColumn" Width="258"/></Grid.ColumnDefinitions>
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="0,14,12,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
 <Image Source="{StaticResource ForgeIcon}" Width="43" Height="50" HorizontalAlignment="Left" Margin="15,0,0,8"/><TextBlock x:Name="BrandWordmark" FontSize="27" FontWeight="SemiBold" Margin="12,0,0,0"><Run Text="Click"/><Run Text="Forge" Foreground="{StaticResource Accent}"/></TextBlock><TextBlock x:Name="BrandDescriptor" Text="DESKTOP CLICK CONTROL" Foreground="{StaticResource Muted}" FontSize="9" Margin="13,5,0,34"/>
 </StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,12,0,0"><Button x:Name="NavDashboard" Style="{StaticResource NavigationButton}" Click="DashboardClicked" AutomationProperties.Name="Dashboard" ToolTip="Dashboard" Tag="Selected"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconHome}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavDashboardLabel" Grid.Column="1" Text="Dashboard" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NavProfiles" Style="{StaticResource NavigationButton}" Click="ProfilesClicked" AutomationProperties.Name="Profiles" ToolTip="Profiles" Tag=""><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconLayers}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavProfilesLabel" Grid.Column="1" Text="Profiles" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NavTarget" Style="{StaticResource NavigationButton}" Click="TargetClicked" AutomationProperties.Name="Target" ToolTip="Target" Tag=""><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconTarget}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavTargetLabel" Grid.Column="1" Text="Target" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NavSettings" Style="{StaticResource NavigationButton}" Click="SettingsClicked" AutomationProperties.Name="Settings" ToolTip="Settings" Tag=""><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconSettings}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavSettingsLabel" Grid.Column="1" Text="Settings" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NavHotkeys" Style="{StaticResource NavigationButton}" Click="HotkeysClicked" AutomationProperties.Name="Hotkeys" ToolTip="Hotkeys" Tag=""><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconKeyboard}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavHotkeysLabel" Grid.Column="1" Text="Hotkeys" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button x:Name="NavUpdates" Style="{StaticResource NavigationButton}" Click="UpdatesClicked" AutomationProperties.Name="Updates" ToolTip="Updates" Tag=""><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Data="{StaticResource IconRefresh}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="NavUpdatesLabel" Grid.Column="1" Text="Updates" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Button></StackPanel><StackPanel x:Name="RailFooter" Grid.Row="2" Margin="14,0,0,0"><TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="RailState" Text="●  Ready" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Grid></Border>
 <ScrollViewer x:Name="DashboardScroll" SizeChanged="DashboardSizeChanged" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,4,20,12">
 <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Dashboard" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ActiveProfileText" Grid.Column="1" Text="Custom configuration" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="270" AutomationProperties.Name="Active configuration profile"/></Grid>
   <Border Style="{StaticResource PanelStyle}" Padding="20,21" Margin="0,0,0,12"><Grid x:Name="StatusGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="StateRing" Background="{StaticResource Base}" BorderBrush="{StaticResource GoldEdge}" BorderThickness="3" CornerRadius="37" Width="74" Height="74" Margin="0,0,18,0" VerticalAlignment="Center"><Grid><TextBlock x:Name="StateGlyph" Text="■" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,9,9"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Stopped" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="StateHintText" Text="Ready to start" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></Grid>
   <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="17,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="RobloxStatusText" Text="No verified foreground" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TargetText" Text="Roblox foreground required" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,8,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CycleText" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="input pairs sent" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ConfiguredCpsText" Text="10" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="configured CPS" Style="{StaticResource Hint}" Margin="0,4,0,0"/><TextBlock x:Name="ConfiguredIntervalText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid></Border>
  <Border Style="{StaticResource PanelStyle}" Padding="0" Margin="0,0,0,12"><StackPanel>
   <StackPanel Margin="22,16,22,16">
    <DockPanel Margin="0,0,0,9"><TextBlock Text="Click speed" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="FixedTimingInput" Content="Fixed CPS" GroupName="Timing" Style="{StaticResource TimingSegment}" Checked="TimingModeChanged" Padding="22,10"/><RadioButton x:Name="VariableTimingInput" Content="Variable CPS" GroupName="Timing" Style="{StaticResource TimingSegment}" Checked="TimingModeChanged" Padding="22,10" Margin="4,0,0,0"/></StackPanel></DockPanel>
    <StackPanel x:Name="FixedSpeedPanel"><TextBlock Text="Set how many clicks to send per second." Style="{StaticResource Hint}" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><TextBox x:Name="CpsInput" Foreground="{StaticResource Accent}" Padding="8,3" Text="10" Width="100" FontSize="44" FontWeight="SemiBold" HorizontalContentAlignment="Center" AutomationProperties.Name="Clicks per second, 1 to 50" TextChanged="CpsTyped" PreviewKeyDown="CpsKeyDown" LostFocus="CpsLostFocus"/><TextBlock Foreground="{StaticResource Muted}" FontSize="18" Text="CPS" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
    <Slider x:Name="CpsSlider" Minimum="1" Maximum="50" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,5" AutomationProperties.Name="Click speed" ValueChanged="SpeedChanged"/><Grid><TextBlock Text="1 CPS" Style="{StaticResource Hint}"/><TextBlock x:Name="IntervalText" Text="100 ms interval" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><TextBlock Text="50 CPS" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid></StackPanel>
    <StackPanel x:Name="VariableSpeedPanel" Visibility="Collapsed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><DockPanel><Label Content="Minimum CPS" Target="{Binding ElementName=MinimumCpsInput}" Padding="0"/><TextBox x:Name="MinimumCpsInput" Padding="8,3" FontSize="26" Width="76" HorizontalAlignment="Right" TextChanged="VariableTyped" AutomationProperties.Name="Minimum CPS, 1 to 50"/></DockPanel><Slider x:Name="MinimumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" AutomationProperties.Name="Minimum CPS" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0"><DockPanel><Label Content="Maximum CPS" Target="{Binding ElementName=MaximumCpsInput}" Padding="0"/><TextBox x:Name="MaximumCpsInput" Padding="8,3" FontSize="26" Width="76" HorizontalAlignment="Right" TextChanged="VariableTyped" AutomationProperties.Name="Maximum CPS, 1 to 50"/></DockPanel><Slider x:Name="MaximumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" AutomationProperties.Name="Maximum CPS" Margin="0,5,0,0"/></StackPanel>
     </Grid>
     <TextBlock x:Name="VariableRangeText" Foreground="{StaticResource Accent}" Margin="0,6,0,6" TextWrapping="Wrap"/>

     <Button Content="Choose target window" Click="TargetClicked" HorizontalAlignment="Left" Padding="12,7" Margin="0,4,0,0"/><TextBlock Text="An explicitly selected window must be in front, valid, and under the pointer." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <TextBlock x:Name="VariableValidationText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
    </StackPanel>
   </StackPanel>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="StartClicked" Padding="12,12" Margin="0,0,8,0" ToolTip="Explicitly start or stop clicking. Roblox-only mode waits for a verified foreground client."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StartIcon" Foreground="{StaticResource Ink}" Text="▶" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="StartLabel" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Grid.Column="1" Text="Start clicking" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{StaticResource KeycapWash}" BorderBrush="{StaticResource GoldEdge}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0"><TextBlock x:Name="StartKeyText" Text="F6" FontSize="12" Foreground="{StaticResource Ink}"/></Border></Grid></Button>
    <Button x:Name="PauseButton" Grid.Column="1" Click="PauseClicked" Padding="10,12" Margin="0,0,8,0" ToolTip="Pause and resume an active request"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Ⅱ" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/><Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="5,3" Margin="10,0,0,0"><TextBlock x:Name="PauseKeyText" Text="F7" FontSize="12" Foreground="{StaticResource Muted}"/></Border></StackPanel></Button>
    <Button x:Name="EmergencyButton" Grid.Column="2" Style="{StaticResource EmergencyButton}" Click="EmergencyClicked" Padding="10,12" ToolTip="Stops immediately in every activation mode"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="■" Foreground="{StaticResource Failure}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="EmergencyText" Text="Emergency stop" Foreground="{StaticResource Failure}" VerticalAlignment="Center"/><Border BorderBrush="{StaticResource FailureBorder}" BorderThickness="1" CornerRadius="4" Padding="5,3" Margin="10,0,0,0"><TextBlock x:Name="StopKeyText" Text="F8" FontSize="12" Foreground="{StaticResource Failure}"/></Border></StackPanel></Button>
   </Grid></Border>
  </StackPanel></Border>
  <Grid x:Name="OptionsGrid" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="ModePanel" Style="{StaticResource PanelStyle}" Margin="0,0,6,0" Padding="17,15"><StackPanel><TextBlock Text="Activation mode" Style="{StaticResource SectionTitle}"/><Grid Margin="0,11,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="ToggleModeInput" Content="Toggle" Style="{StaticResource Segment}" GroupName="Activation" IsChecked="True" Checked="ModeSegmentChanged" Margin="0,0,2,0" AutomationProperties.Name="Toggle activation mode"/><RadioButton x:Name="HoldModeInput" Grid.Column="1" Content="Hold" Style="{StaticResource Segment}" GroupName="Activation" Checked="ModeSegmentChanged" Margin="2,0,0,0" AutomationProperties.Name="Hold activation mode"/></Grid><TextBlock x:Name="ModeHelp" Text="Press F6 once to start, again to stop." Style="{StaticResource Hint}"/></StackPanel></Border>
   <Border x:Name="RestrictionPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="6,0,0,0" Padding="17,20"><StackPanel><CheckBox x:Name="RestrictInput" IsChecked="True" Checked="RestrictionChanged" Unchecked="RestrictionChanged"><TextBlock Text="Only click while Roblox is in front" FontWeight="SemiBold" TextWrapping="Wrap"/></CheckBox><TextBlock x:Name="RestrictionHelp" Text="Clicking pauses automatically when Roblox loses foreground focus." Style="{StaticResource Hint}" Margin="34,10,0,0"/></StackPanel></Border>
  </Grid>
  <Border Style="{StaticResource PanelStyle}" Padding="17,12" Margin="0,0,0,12"><Expander x:Name="ShortcutsExpander" Header="Global shortcuts" AutomationProperties.Name="Configure global shortcuts"><StackPanel Margin="0,10,0,0"><Grid><StackPanel><TextBlock Text="Hotkey configuration" Style="{StaticResource SectionTitle}"/><TextBlock Text="Change the global keyboard shortcuts." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel><Button Content="Reset shortcuts" Click="ResetClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,8" FontSize="12"/></Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Activate" Style="{StaticResource Hint}" Margin="0,0,0,6"/><ComboBox x:Name="ActivateInput" AutomationProperties.Name="Activation hotkey"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Pause / resume" Style="{StaticResource Hint}" Margin="0,0,0,6"/><ComboBox x:Name="PauseInput" AutomationProperties.Name="Pause hotkey"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Emergency stop" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="StopInput" AutomationProperties.Name="Emergency stop hotkey"/></StackPanel><Button Grid.Column="3" Content="✓  Apply shortcuts" Click="ApplyClicked" VerticalAlignment="Bottom" Padding="12,9" Background="{StaticResource Elevated}" BorderBrush="{StaticResource AccentSoft}"/></Grid>
  </StackPanel></Expander></Border>
  <Border Style="{StaticResource PanelStyle}" Padding="17,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource GoldWash}" Width="41" Height="41" CornerRadius="21" Margin="0,0,14,0" VerticalAlignment="Center"><Path Data="{StaticResource IconTarget}" Style="{StaticResource LineIcon}" Stroke="{StaticResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><DockPanel><TextBlock Text="Safe click test" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SafeTestBadge" Text="Controlled test" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel><ComboBox x:Name="SafeTestModeInput" SelectionChanged="SafeModeDescriptionChanged" SelectedIndex="0" MaxWidth="300" MinHeight="30" HorizontalAlignment="Left" Margin="0,5,0,0" ToolTip="Variable timing generates only logical events inside Safe Click Test." AutomationProperties.Name="Safe click test timing mode"><ComboBoxItem Content="Fixed CPS · controlled target"/><ComboBoxItem Content="Variable Timing — Safe Test Only"/></ComboBox><TextBlock x:Name="SafeTestDescription" Text="Fixed CPS sends input only to the controlled test pad." Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Content="▶  Open test" Click="TestClicked" VerticalAlignment="Center" Padding="16,11"/></Grid></Border>
  <TextBlock x:Name="MessageText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Margin="2,10,2,0" AutomationProperties.LiveSetting="Polite"/>

 </StackPanel></ScrollViewer>
 <ScrollViewer x:Name="InspectorHost" Grid.Column="2" Margin="0,40,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="InspectorContent">
 <Border Style="{StaticResource PanelStyle}" Padding="18" Margin="0,0,0,12"><StackPanel>
 <DockPanel Margin="0,0,0,16"><Path Data="{StaticResource IconTarget}" Style="{StaticResource LineIcon}" Stroke="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Selected target" FontSize="15" FontWeight="SemiBold"/></DockPanel>
 <Border Background="{StaticResource Base}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,14"><StackPanel><Path Data="{StaticResource IconWindow}" Style="{StaticResource LineIcon}" Width="36" Height="36" Stroke="{StaticResource Muted}" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock x:Name="InspectorIdentity" Text="No window selected" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="InspectorVerification" Text="Choose a target for Variable CPS" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
 <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
 <TextBlock Text="Process" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorProcess" Grid.Column="1" Text="—" TextWrapping="Wrap" FontSize="12"/>
 <TextBlock Grid.Row="1" Text="Title" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorTitle" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" FontSize="12"/>
 <TextBlock Grid.Row="2" Text="Focus" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorFocus" Grid.Row="2" Grid.Column="1" Text="No target" FontSize="12"/>
 <TextBlock Grid.Row="3" Text="Window" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBlock x:Name="InspectorValidity" Grid.Row="3" Grid.Column="1" Text="Not selected" FontSize="12"/>
 <TextBlock Grid.Row="4" Text="Pointer" Style="{StaticResource Hint}"/><TextBlock x:Name="InspectorPointer" Grid.Row="4" Grid.Column="1" Text="Not measured" FontSize="12" TextWrapping="Wrap"/></Grid>
      <StackPanel><Button Content="Refresh windows"  Click="RefreshTargetsClicked" Padding="10,6" Margin="0,0,0,8"/><Grid><ComboBox x:Name="DesktopTargetInput" MinWidth="100" SelectionChanged="DesktopTargetChanged" AutomationProperties.Name="Required target window, including verified Roblox" ToolTip="Select Roblox or another desktop window. Roblox clients must pass signature verification."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" MaxWidth="205" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="TargetPlaceholder" Text="Select a window…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="12,7,30,7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></StackPanel>
 <TextBlock x:Name="InspectorFeedback" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="Variable CPS uses this exact window. Fixed CPS follows its saved foreground restriction." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
 </StackPanel></Border>
 <Border Style="{StaticResource PanelStyle}" Padding="18"><StackPanel><DockPanel Margin="0,0,0,14"><Path Data="{StaticResource IconLayers}" Style="{StaticResource LineIcon}" Stroke="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Profile" FontWeight="SemiBold" FontSize="15"/></DockPanel>
 <Grid><ComboBox x:Name="QuickProfileInput" AutomationProperties.Name="Apply a saved timing profile" SelectionChanged="QuickProfileChanged" ToolTip="Selecting a saved profile applies it and stops clicking."/><TextBlock x:Name="ProfilePlaceholder" Text="Custom configuration" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="12,7,30,7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid><TextBlock x:Name="QuickProfileSummary" Style="{StaticResource Hint}" Text="Custom configuration" Margin="0,9,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Save" Click="QuickProfileSaveClicked" Margin="0,0,5,0" Padding="8,9"/><Button Grid.Column="1" Content="Manage" Click="ProfilesClicked" Margin="5,0,0,0" Padding="8,9"/></Grid></StackPanel></Border>
 </StackPanel></ScrollViewer>
 </Grid>
</Window>
