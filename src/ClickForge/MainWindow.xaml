<Window x:Class="ClickForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClickForge" Icon="{StaticResource ForgeIcon}" Width="880" Height="900" MinWidth="620" MinHeight="600" Background="{StaticResource Base}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" SizeChanged="LayoutChanged">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,18,20,16">
  <Grid Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{StaticResource ForgeIcon}" Width="45" Height="45" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="ClickForge" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Roblox Autoclicker" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" FontSize="12"/></Border><Button Content="Updates" Click="UpdatesClicked" Margin="8,0,0,0" Padding="10,6" FontSize="12"/></StackPanel></Grid>
  <Border Style="{StaticResource PanelStyle}" Padding="17,17" Margin="0,0,0,12"><Grid x:Name="StatusGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1D2C41" CornerRadius="18" Width="36" Height="36" Margin="0,0,11,0" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#9BAFCB"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Stopped" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StateHintText" Text="Ready to start" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></Grid>
   <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="17,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="RobloxStatusText" Text="No verified foreground" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TargetText" Text="Roblox foreground required" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,8,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CycleText" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="clicks sent" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ConfiguredCpsText" Text="10" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="CPS" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Border Style="{StaticResource PanelStyle}" Padding="0" Margin="0,0,0,12"><StackPanel>
   <StackPanel Margin="18,12,18,12">
    <DockPanel Margin="0,0,0,9"><TextBlock Text="Click speed" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="FixedTimingInput" Content="Fixed CPS" GroupName="Timing" Style="{StaticResource Segment}" Checked="TimingModeChanged" Padding="12,6"/><RadioButton x:Name="VariableTimingInput" Content="Variable CPS" GroupName="Timing" Style="{StaticResource Segment}" Checked="TimingModeChanged" Padding="12,6" Margin="4,0,0,0"/></StackPanel></DockPanel>
    <StackPanel x:Name="FixedSpeedPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Set how many clicks to send per second." Style="{StaticResource Hint}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="CpsInput" Padding="8,3" Text="10" Width="73" FontSize="19" FontWeight="SemiBold" HorizontalContentAlignment="Center" AutomationProperties.Name="Clicks per second, 1 to 50" TextChanged="CpsTyped" PreviewKeyDown="CpsKeyDown" LostFocus="CpsLostFocus"/><TextBlock Text="CPS" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid>
    <Slider x:Name="CpsSlider" Minimum="1" Maximum="50" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,5" AutomationProperties.Name="Click speed" ValueChanged="SpeedChanged"/><Grid><TextBlock Text="1 CPS" Style="{StaticResource Hint}"/><TextBlock x:Name="IntervalText" Text="100 ms interval" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><TextBlock Text="50 CPS" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid></StackPanel>
    <StackPanel x:Name="VariableSpeedPanel" Visibility="Collapsed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><DockPanel><Label Content="Minimum CPS" Target="{Binding ElementName=MinimumCpsInput}" Padding="0"/><TextBox x:Name="MinimumCpsInput" Padding="8,3" Width="58" HorizontalAlignment="Right" TextChanged="VariableTyped" AutomationProperties.Name="Minimum CPS, 1 to 50"/></DockPanel><Slider x:Name="MinimumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" AutomationProperties.Name="Minimum CPS" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0"><DockPanel><Label Content="Maximum CPS" Target="{Binding ElementName=MaximumCpsInput}" Padding="0"/><TextBox x:Name="MaximumCpsInput" Padding="8,3" Width="58" HorizontalAlignment="Right" TextChanged="VariableTyped" AutomationProperties.Name="Maximum CPS, 1 to 50"/></DockPanel><Slider x:Name="MaximumCpsSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VariableSliderChanged" AutomationProperties.Name="Maximum CPS" Margin="0,5,0,0"/></StackPanel>
     </Grid>
     <TextBlock x:Name="VariableRangeText" Foreground="{StaticResource Accent}" Margin="0,6,0,6" TextWrapping="Wrap"/>
     <DockPanel><Button Content="Refresh windows" DockPanel.Dock="Right" Click="RefreshTargetsClicked" Padding="10,6" Margin="8,0,0,0"/><ComboBox x:Name="DesktopTargetInput" MinWidth="100" SelectionChanged="DesktopTargetChanged" AutomationProperties.Name="Required target window, including verified Roblox" ToolTip="Select Roblox or another desktop window. Roblox clients must pass signature verification."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" MaxWidth="540" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
     <TextBlock Text="Select Roblox or another desktop window. Input pauses unless it is in front and under the pointer. Refresh to find open applications." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <TextBlock x:Name="VariableValidationText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0"/>
    </StackPanel>
   </StackPanel>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="StartClicked" Padding="12,12" Margin="0,0,8,0" ToolTip="Explicitly start or stop clicking. Roblox-only mode waits for a verified foreground client."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StartIcon" Text="▶" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="StartLabel" Grid.Column="1" Text="Start clicking" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="#223C6999" BorderBrush="#548AD4" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="12,0,0,0"><TextBlock x:Name="StartKeyText" Text="F6" FontSize="12"/></Border></Grid></Button>
    <Button x:Name="PauseButton" Grid.Column="1" Click="PauseClicked" Padding="10,12" Margin="0,0,8,0" ToolTip="Pause and resume an active request"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Ⅱ" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/><Border BorderBrush="#3B5272" BorderThickness="1" CornerRadius="4" Padding="5,3" Margin="10,0,0,0"><TextBlock x:Name="PauseKeyText" Text="F7" FontSize="12" Foreground="{StaticResource Muted}"/></Border></StackPanel></Button>
    <Button x:Name="EmergencyButton" Grid.Column="2" Style="{StaticResource EmergencyButton}" Click="EmergencyClicked" Padding="10,12" ToolTip="Stops immediately in every activation mode"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="■" Foreground="#F05C68" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="EmergencyText" Text="Emergency stop" Foreground="#F8838D" VerticalAlignment="Center"/><Border BorderBrush="#73404D" BorderThickness="1" CornerRadius="4" Padding="5,3" Margin="10,0,0,0"><TextBlock x:Name="StopKeyText" Text="F8" FontSize="12" Foreground="#F0BAC2"/></Border></StackPanel></Button>
   </Grid></Border>
  </StackPanel></Border>
  <Grid x:Name="OptionsGrid" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="ModePanel" Style="{StaticResource PanelStyle}" Margin="0,0,6,0" Padding="17,15"><StackPanel><TextBlock Text="Activation mode" Style="{StaticResource SectionTitle}"/><Grid Margin="0,11,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="ToggleModeInput" Content="↖   Toggle" Style="{StaticResource Segment}" GroupName="Activation" IsChecked="True" Checked="ModeSegmentChanged" Margin="0,0,2,0" AutomationProperties.Name="Toggle activation mode"/><RadioButton x:Name="HoldModeInput" Grid.Column="1" Content="⌨   Hold" Style="{StaticResource Segment}" GroupName="Activation" Checked="ModeSegmentChanged" Margin="2,0,0,0" AutomationProperties.Name="Hold activation mode"/></Grid><TextBlock x:Name="ModeHelp" Text="Press F6 once to start, again to stop." Style="{StaticResource Hint}"/></StackPanel></Border>
   <Border x:Name="RestrictionPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="6,0,0,0" Padding="17,20"><StackPanel><CheckBox x:Name="RestrictInput" IsChecked="True" Checked="RestrictionChanged" Unchecked="RestrictionChanged"><TextBlock Text="Only click while Roblox is in front" FontWeight="SemiBold" TextWrapping="Wrap"/></CheckBox><TextBlock x:Name="RestrictionHelp" Text="Clicking pauses automatically when Roblox loses foreground focus." Style="{StaticResource Hint}" Margin="34,10,0,0"/></StackPanel></Border>
  </Grid>
  <Border Style="{StaticResource PanelStyle}" Padding="17,15" Margin="0,0,0,12"><StackPanel><Grid><StackPanel><TextBlock Text="Hotkey configuration" Style="{StaticResource SectionTitle}"/><TextBlock Text="Change the global keyboard shortcuts." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel><Button Content="↶   Reset defaults" Click="ResetClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,8" FontSize="12"/></Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Activate" Style="{StaticResource Hint}" Margin="0,0,0,6"/><ComboBox x:Name="ActivateInput" AutomationProperties.Name="Activation hotkey"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Pause / resume" Style="{StaticResource Hint}" Margin="0,0,0,6"/><ComboBox x:Name="PauseInput" AutomationProperties.Name="Pause hotkey"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Emergency stop" Foreground="#FFB454" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="StopInput" AutomationProperties.Name="Emergency stop hotkey"/></StackPanel><Button Grid.Column="3" Content="✓  Apply shortcuts" Click="ApplyClicked" VerticalAlignment="Bottom" Padding="12,9" Background="#1C3860" BorderBrush="#438BFF"/></Grid>
  </StackPanel></Border>
  <Border Style="{StaticResource PanelStyle}" Padding="17,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#1B2A40" Width="41" Height="41" CornerRadius="21" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="28" Foreground="#75B1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Safe click test" FontSize="15" FontWeight="SemiBold"/><ComboBox x:Name="SafeTestModeInput" SelectedIndex="0" MaxWidth="320" MinHeight="30" HorizontalAlignment="Left" Margin="0,5,0,0" ToolTip="Variable timing generates only logical events inside Safe Click Test." AutomationProperties.Name="Safe click test timing mode"><ComboBoxItem Content="Fixed CPS · controlled target"/><ComboBoxItem Content="Variable Timing — Safe Test Only"/></ComboBox></StackPanel><Button Grid.Column="2" Content="▶  Open test" Click="TestClicked" VerticalAlignment="Center" Padding="16,11"/></Grid></Border>
  <TextBlock x:Name="MessageText" Foreground="#FFB454" TextWrapping="Wrap" FontSize="12" Margin="2,10,2,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
</Window>
